# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" nunca é enviado para o GitHub (veja o .gitignore).

# Porta em que o servidor roda localmente
PORT=3000

# --- Etapa 2: NVIDIA Build (provedor de teste, gratuito) ---
# Gerada em https://build.nvidia.com (Developer Program, sem cartão de crédito) — mesma chave
# usada pelo assistente do WhatsApp E pela "Entrada rápida por IA" da Loja 3D (texto e foto de
# recibo, via um modelo com visão).
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# --- Opcional: Anthropic (Claude) ---
# Destino final quando decidir migrar o assistente do WhatsApp do provedor de teste pro Claude
# de verdade. Não é usada pela Loja 3D.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Opcional: OpenAI (Whisper) ---
# Só usada pela opção de ÁUDIO da "Entrada rápida por IA" da Loja 3D, pra transcrever antes de
# interpretar (é paga, ao contrário do NVIDIA_API_KEY acima). Sem essa chave, a entrada por
# texto e por foto continuam funcionando normalmente de graça — só a opção de áudio fica
# desabilitada.
OPENAI_API_KEY=

# --- Etapa 3: Supabase (banco de dados) ---
# Encontrados em Project Settings > API, no painel do Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Chave "anon public" (mesma tela). Usada pela Loja 3D no navegador; é protegida pelas
# políticas de RLS da tabela pedidos_3d, então não é problema ela ser pública.
SUPABASE_ANON_KEY=

# --- Etapa 4: WhatsApp (Meta Cloud API) ---
# Gerados no Meta for Developers, dentro do seu App
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Um texto que você mesmo inventa, usado para o Meta confirmar que o webhook é seu
WHATSAPP_VERIFY_TOKEN=
