# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" nunca é enviado para o GitHub (veja o .gitignore).

# --- Núcleo ---
PORT=3000
# Fuso usado para saber que dia é "hoje" (o servidor do Render roda em UTC)
APP_TIMEZONE=America/Sao_Paulo
# A senha que você digita para entrar no app
APP_SENHA=
# Texto longo e aleatório usado para assinar o cookie de login.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Identificador dos seus dados no banco. Deixe "eu" enquanto o app for só seu.
APP_USER_ID=eu

# --- Supabase (banco de dados) ---
# Encontrados em Project Settings > API, no painel do Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- IA (interpretação das mensagens de texto/áudio do WhatsApp) ---
# Uma chave só, 100% grátis: console.groq.com (cadastro sem cartão).
# GROQ_MODEL_TEXTO entende a mensagem e extrai o lançamento (valor, tipo, categoria);
# GROQ_MODEL transcreve a nota de voz antes disso (texto digitado não passa por aqui).
# Se o nome do modelo mudar no futuro, confira a lista atual em console.groq.com/docs/models.
GROQ_API_KEY=
GROQ_MODEL_TEXTO=llama-3.3-70b-versatile
GROQ_MODEL=whisper-large-v3-turbo

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Um texto que você mesmo inventa, usado pelo Meta para confirmar que o webhook é seu
WHATSAPP_VERIFY_TOKEN=
# O SEU número de WhatsApp (o que manda as mensagens), com DDI e DDD, exatamente
# como aparece no payload do webhook (ex: 5511999999999, sem "+" e sem espaço).
# É a única trava de segurança dessa rota pública — sem isso configurado, o
# webhook ignora toda mensagem recebida por precaução.
WHATSAPP_MEU_NUMERO=
