# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" nunca é enviado para o GitHub (veja o .gitignore).

# Porta em que o servidor roda localmente
PORT=3000

# --- Etapa 2: Google Gemini (interpretação das mensagens) ---
# Gerada em https://aistudio.google.com/ (grátis, não pede cartão de crédito)
GEMINI_API_KEY=
# Confira no AI Studio qual é o modelo "Flash" gratuito mais atual antes de trocar este valor
GEMINI_MODEL=gemini-2.0-flash

# --- Opcional: Anthropic (Claude) ---
# Só necessário se/quando migrar do Gemini para o Claude no futuro
ANTHROPIC_API_KEY=

# --- Etapa 3: Supabase (banco de dados) ---
# Encontrados em Project Settings > API, no painel do Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Etapa 4: WhatsApp (Meta Cloud API) ---
# Gerados no Meta for Developers, dentro do seu App
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Um texto que você mesmo inventa, usado para o Meta confirmar que o webhook é seu
WHATSAPP_VERIFY_TOKEN=
